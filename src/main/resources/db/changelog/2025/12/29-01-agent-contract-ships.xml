                <constraints nullable="false"/>
            </column>
            <column name="accepted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="fulfilled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="deadline_to_accept" type="DATETIME"/>
            <column name="terms_deadline" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="terms_payment_on_accepted" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="terms_payment_on_fulfilled" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1767060967875-4" author="zach">
        <createTable tableName="contract_deliver">
            <column name="contract_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
